# Salin ke .env.local lalu isi. Kosong = aplikasi tetap jalan memakai localStorage saja.
NEXT_PUBLIC_SUPABASE_URL=
# Anon key publik, dipakai HP guru untuk login saat scan QR Mode Guru.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia, hanya dipakai di server (route handler). Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
